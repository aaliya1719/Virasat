# Virasat Backend — Environment Variables
# Copy this file to .env (git-ignored) and fill in real values.
# Never commit .env or any file with real credentials.

# ── Database ─────────────────────────────────────────────────────────────────

# Local development (SQLite fallback — no action needed, this is the default)
# DATABASE_URL=sqlite:///./virasat.db

# Production: Supabase PostgreSQL (Transaction Pooler — port 6543, recommended for FastAPI)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Production: Supabase PostgreSQL (Session Pooler — port 5432, use if transaction pooler is unavailable)
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Direct connection (bypasses pooler — use only for migrations or admin tasks)
# DATABASE_URL=postgresql+psycopg2://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres

DATABASE_URL=sqlite:///./virasat.db

# Supabase Auth validation for protected FastAPI routes.
# These are the project URL and public anon key, not database credentials.
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_ANON_KEY=[public-anon-key]

# ── Gemini API (Phase 2 — AI Chat) ──────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ─────────────────────────────────────────────────────────────────
# SECRET_KEY=your_secret_key_here
